 private:
+    std::vector<std::pair<std::string, ggml_tensor *>> diagnostic_;
+    void capture(const std::string & label, const core::TensorValue & value) {
+        if (std::getenv("AUDIOCPP_DEMUCS_DIAGNOSTIC_PREFIX") != nullptr) {
+            if (value.tensor->type != GGML_TYPE_F32) { throw std::runtime_error("diagnostic expects F32"); }
+            diagnostic_.emplace_back(label, value.tensor);
+        }
+    }
+    void dump_diagnostics() {
+        const char * prefix = std::getenv("AUDIOCPP_DEMUCS_DIAGNOSTIC_PREFIX");
+        if (prefix == nullptr) { return; }
+        for (const auto & item : diagnostic_) {
+            auto * tensor = item.second;
+            std::vector<char> bytes(ggml_nbytes(tensor));
+            ggml_backend_tensor_get(tensor, bytes.data(), 0, bytes.size());
+            const auto base = std::string(prefix) + "_" + item.first;
+            std::ofstream binary(base + ".bin", std::ios::binary);
+            binary.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+            if (!binary) { throw std::runtime_error("diagnostic tensor write failed"); }
+            std::ofstream metadata(base + ".json");
+            metadata << "{\"type\":\"f32\",\"ne\":[";
+            for (int i = 0; i < 4; ++i) { metadata << (i ? "," : "") << tensor->ne[i]; }
+            metadata << "],\"nb\":[";
+            for (int i = 0; i < 4; ++i) { metadata << (i ? "," : "") << tensor->nb[i]; }
+            metadata << "]}\n";
+            if (!metadata) { throw std::runtime_error("diagnostic metadata write failed"); }
+        }
+    }
